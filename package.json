{
  "name": "smart-phrases",
  "displayName": "Smart Phrases",
  "description": "Auto-replace text phrases as you type",
  "version": "0.0.1",
  "publisher": "maxs-lab-of-things",
  "homepage": "https://mlot.ai",
  "author": {
    "name": "Max Marquardt",
    "url": "https://mlot.ai"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "icon": "Group-21.png",
  "keywords": [
    "text replacement",
    "auto replace",
    "snippets",
    "productivity",
    "shortcuts",
    "abbreviations",
    "text expander",
    "typing"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartPhrases.openPanel",
        "title": "Open Smart Phrases Panel",
        "category": "Smart Phrases"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.2.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "glob": "^8.0.3",
    "mocha": "^10.1.0"
  }
}