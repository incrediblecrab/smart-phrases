{
  "name": "smart-phrases",
  "displayName": "Smart Phrases",
  "description": "Auto-complete smart phrases with trigger words for efficient typing",
  "version": "1.5.1",
  "publisher": "maxs-lab-of-things",
  "homepage": "https://mlot.ai",
  "author": {
    "name": "Max Marquardt",
    "url": "https://mlot.ai"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "icon": "Group-21.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartPhrases.managePhrases",
        "title": "Manage Smart Phrases",
        "category": "Smart Phrases"
      }
    ],
    "configuration": {
      "title": "Smart Phrases",
      "properties": {
        "smartPhrases.triggerOnSpace": {
          "type": "boolean",
          "default": true,
          "description": "Trigger phrase expansion when pressing space"
        },
        "smartPhrases.triggerOnTab": {
          "type": "boolean",
          "default": true,
          "description": "Trigger phrase expansion when pressing tab"
        },
        "smartPhrases.triggerOnEnter": {
          "type": "boolean",
          "default": false,
          "description": "Trigger phrase expansion when pressing enter"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "vsce": {
    "dependencies": false
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/mocha": "^10.0.10",
    "@types/glob": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "typescript": "^4.9.5",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2",
    "glob": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incrediblecrab/smart-phrases.git"
  },
  "bugs": {
    "url": "https://github.com/incrediblecrab/smart-phrases/issues"
  }
}
